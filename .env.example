# ============================================================
# CẤU HÌNH TRỢ LÝ AI (MED-EXPERT)
# Sao chép file này thành ".env" (cùng thư mục với may_chu.js) rồi điền giá trị.
# File .env đã được đưa vào .gitignore - KHÔNG commit API key.
# ============================================================

# Nhà cung cấp: gemini | ollama
AI_PROVIDER=gemini

# --- Google Gemini (miễn phí theo free tier) ---
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model (đổi theo danh sách model khả dụng trong AI Studio nếu báo lỗi 404)
# Flash Lite có hạn mức free tier cao nhất trong dòng Flash (15 request/phút, 500 request/ngày)
GEMINI_MODEL=gemini-3.5-flash-lite
# Flash Lite: để trống. Nếu dùng gemini-3.5-flash: đặt 0 để tắt "suy nghĩ" (~2s thay vì ~60s)
GEMINI_THINKING_BUDGET=
# Hạn mức free tier của model trên (xem tại https://aistudio.google.com/rate-limit)
# Dùng để hiển thị "quota còn lại" trên giao diện. Để trống: hệ thống tự học giới hạn khi Google báo lỗi 429
GEMINI_RPD_LIMIT=500
GEMINI_RPM_LIMIT=15

# --- Ollama (chạy cục bộ, offline, miễn phí hoàn toàn) ---
# Cài tại https://ollama.com rồi chạy: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
